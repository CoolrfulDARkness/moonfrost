name = "CoolrfulDARkness/moonfrost"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/CoolrfulDARkness/moonfrost"

license = "Apache-2.0"

keywords = [
  "cryptography",
  "frost",
  "rfc9591",
  "threshold-signatures",
  "schnorr",
  "dkg",
  "ristretto255",
  "p256",
  "constant-time",
]

preferred_target = "wasm"

description = "Pure MoonBit, zero-FFI, constant-time IETF RFC 9591 FROST threshold Schnorr signature protocol stack (Ristretto255-SHA512 & P-256-SHA256, Feldman VSS, Pedersen DKG, Identifiable Abort)."
